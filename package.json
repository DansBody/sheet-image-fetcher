{
  "name": "sheet-image-fetcher",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build": "node scripts/build-worker.mjs",
    "worker:dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "check": "node --check server.js && node --check scripts/build-worker.mjs",
    "test": "node server.test.js"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "cheerio": "^1.0.0",
    "express": "^5.2.1",
    "playwright": "^1.59.1"
  },
  "devDependencies": {
    "@cloudflare/playwright": "^1.3.0",
    "wrangler": "^4.68.0"
  }
}
