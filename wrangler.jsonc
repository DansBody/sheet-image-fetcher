{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sheet-image-fetcher",
  "main": "dist/worker.js",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public/"
  },
  "browser": {
    "binding": "BROWSER"
  },
  "observability": {
    "enabled": true
  }
}
